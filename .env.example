# Aurora Intents API key — create one free at https://studio.aurora.dev (no approval, no payment).
# Used only by the serverless proxy in /api/aurora.ts (never bundled into the client).
AURORA_API_KEY=

# Optional: Solana RPC used by the browser to show SOL/USDC balances (mainnet, because Intents settles on mainnet).
# Defaults to https://solana-rpc.publicnode.com if empty (only non-indexed calls are used, so free public RPCs work).
VITE_SOLANA_RPC=
